+# ---- optional starting loop-length gradient (relax_job --loop-grade a). Off by default: with a = 0 nothing here is called and the start is the uniform ratio of load().
+def loop_grade_factors(Xs, a):
+    """Per-segment factors w that grade the starting rest lengths: radial from the centre of the built fabric, linear in the normalised distance d, short at the centre and longer towards the edges.
+    d = sqrt(u^2 + v^2) with u, v the segment midpoint measured from the centre of the bounding box of the built vertices in units of its half width and half height (x, y), so d = 0 at the centre,
+    d = 1 at the middle of each edge and d = sqrt(2) at the corners. Raw factor 1 + a d; then divided by M, the chord-weighted mean of the raw factors, so that the total rest length of the whole fabric
+    is exactly what the uniform start would give (the grade moves length, it does not add any). With a = 0 every factor is exactly 1.
+    UNSOURCED: the radial direction, the linear profile, the bounding-box normalisation and the value of a are modelling choices (no measured loop-length field exists yet).
+    Returns (list of factor arrays, list of d arrays, M)."""
+    P = np.vstack([X[:, :2] for X in Xs]); lo, hi = P.min(0), P.max(0); c = 0.5*(lo + hi); h = np.maximum(0.5*(hi - lo), 1e-12)
+    d, chord = [], []
+    for X in Xs:
+        mid = 0.5*(X[:-1, :2] + X[1:, :2]); d.append(np.hypot((mid[:, 0] - c[0])/h[0], (mid[:, 1] - c[1])/h[1])); chord.append(np.linalg.norm(np.diff(X, axis=0), axis=1))
+    raw = [1.0 + a*di for di in d]
+    M = sum(float((r*l).sum()) for r, l in zip(raw, chord))/sum(float(l.sum()) for l in chord)
+    return [r/M for r in raw], d, M
+
+def apply_loop_grade(sim, a):
+    """Multiply the rest length of every segment by its grade factor (see loop_grade_factors), in place. Returns a record for meta.json. Call right after load(), before anything reads l0."""
+    w, d, M = loop_grade_factors([y.X for y in sim.yarns], a)
+    before = sum(float(y.l0.sum()) for y in sim.yarns)
+    for y, wi in zip(sim.yarns, w): y.l0 = y.l0*wi
+    after = sum(float(y.l0.sum()) for y in sim.yarns); wall = np.concatenate(w)
+    return dict(a=float(a), direction='radial from the centre of the built fabric', profile='linear in d (d = 0 centre, 1 edge middles, sqrt 2 corners)', conserved='total rest length of the whole fabric (chord-weighted mean factor M)',
+                mean_factor_M=float(M), factor_centre=float(1.0/M), factor_edge_middle=float((1.0 + a)/M), factor_corner=float((1.0 + np.sqrt(2.0)*a)/M), factor_min=float(wall.min()), factor_max=float(wall.max()),
+                total_l0_before=before, total_l0_after=after, unsourced='the direction, the profile, the normalisation and the value of a are modelling choices (UNSOURCED)')
+
 # ---- contacts and wrap angle
 def wrap_angle(X, i, k=3):
     a, b = max(0, i-k), min(len(X)-1, i+k)
